# Copy this file to .env and fill in your keys. Never commit .env.

# Apollo: Settings > Integrations > API Keys (needs People Search + Enrichment access)
APOLLO_API_KEY=

# Saleshandy: Settings > API Key
SALESHANDY_API_KEY=
# The step ID of the sequence step leads should enter (python main.py sequences)
SALESHANDY_STEP_ID=

# Optional: Claude writes the personal openers. Without it, templates are used.
ANTHROPIC_API_KEY=
